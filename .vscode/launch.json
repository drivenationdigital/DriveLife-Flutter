    "version": "0.2.0",
    "configurations": [
        {
            "name": "drivelife",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "drivelife (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "drivelife (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        // Staging mode
        {
            "name": "drivelife (staging mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": ["--dart-define=DL_STAGING=true","--dart-define=DL_WEB_EVENT_OVERVIEW=true"]
        }
    ]
}