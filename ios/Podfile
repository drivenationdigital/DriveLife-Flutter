# Uncomment this line to define a global platform for your project
platform :ios, '15.5.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  # Pin PiwikPROSDK to the version flutter_piwikpro 0.0.3 was written against.
  # The plugin's podspec allows `~> 1.1.2`, but 1.1.x releases after 1.1.2
  # changed several method signatures (sendEvent/sendException/sendSocialInteraction/
  # sendGoal), causing Swift compiler errors in SwiftFlutterPiwikProPlugin.swift.
  pod 'PiwikPROSDK', '1.1.2'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # PiwikPROSDK 1.1.2's podspec carries
  #   user_target_xcconfig => USER_HEADER_SEARCH_PATHS = $(PODS_ROOT)/**
  # and user_target_xcconfig is copied into the CONSUMER's xcconfig, so every
  # Pods-Runner.*.xcconfig inherits a recursive search path over the whole Pods
  # tree. That puts each pod's RAW headers on Runner's quoted-include path while
  # use_frameworks! already exposes the same headers as framework modules, so a
  # header reachable both ways is parsed twice in one translation unit.
  #
  # Harmless until google_sign_in arrived: it pulls GTMSessionFetcher (the root
  # spec, so Core + Full), whose GTMSessionFetcher.h then resolved both ways and
  # produced "Duplicate interface definition for class 'GTMSessionFetcher'".
  #
  # Nothing here imports pod headers by quoted path — every pod is a module — so
  # the setting buys nothing and is stripped from the aggregate targets. The
  # PiwikPROSDK pod target keeps its own copy, which is how it builds itself.
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_build_configurations.each_key do |config_name|
      path = aggregate_target.xcconfig_path(config_name)
      next unless File.exist?(path)
      text = File.read(path)
      next unless text.include?('USER_HEADER_SEARCH_PATHS')
      File.write(path, text.gsub(/^USER_HEADER_SEARCH_PATHS = .*\n/, ''))
    end
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_LOCATION=1',
        'PERMISSION_LOCATION_WHENINUSE=1',
        'PERMISSION_NOTIFICATIONS=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_MICROPHONE=1',
      ]
    end
  end
end
